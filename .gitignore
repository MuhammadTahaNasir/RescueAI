temp_audio/
backend/temp_audio/
*.wav
*.mp3

# ── Frontend build artifacts ──────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
*.tsbuildinfo


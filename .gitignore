# ── Secrets & environment files ──────────────────────────────────────────────
.env
.env.*
!.env.example
backend/.env
frontend/.env
frontend/.env.*



# ── Python artifacts ──────────────────────────────────────────────────────────
__pycache__/
backend/__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

